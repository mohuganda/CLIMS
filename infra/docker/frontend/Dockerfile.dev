# syntax=docker/dockerfile:1

# Development image: the Vite dev server with hot reload. Mount the frontend
# directory over /app so edits on the host are picked up:
#
#   docker build -f infra/docker/frontend/Dockerfile.dev -t clims-frontend-dev .
#   docker run --rm -p 3000:3000 -v "$PWD/frontend/src:/app/src" clims-frontend-dev
#
# Not for production: it serves unminified code and exposes the dev tooling.

FROM node:24-alpine
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./

USER node
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
