# Copy to `.env.local` for local development.

# Where `npm run dev` forwards /api, /docs and /health. Server-side only; the
# browser always calls this app's own origin. Defaults to the Nginx gateway.
# Point it at the mock API (http://127.0.0.1:8787) to work without a backend.
BACKEND_URL=http://localhost:8080

# Next.js inlines every NEXT_PUBLIC_* value into the public bundle at build
# time, so nothing below may be a secret.

# Base URL the browser calls for the API. Leave as `/api` when the app is served
# behind the repo's Nginx gateway or the dev rewrites above; use an absolute URL
# only when the API lives on another origin and allows this one via CORS.
NEXT_PUBLIC_API_BASE_URL=/api

# Browser key for the hotspot map. Restrict it by HTTP referrer in Google Cloud;
# a browser key is visible to every visitor, the referrer restriction is the
# control. The map page shows a notice instead of a map when this is empty.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
