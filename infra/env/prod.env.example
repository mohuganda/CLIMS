# Database (Use strong, secure passwords in production)
MYSQL_ROOT_PASSWORD=super_secure_root_password_here
MYSQL_DATABASE=clims_db
MYSQL_USER=clims_user
MYSQL_PASSWORD=super_secure_db_password_here
DB_PORT=3306

# Backend
DB_HOST=mariadb
DB_NAME=clims_db
DB_USER=clims_user
DB_PASSWORD=super_secure_db_password_here
PORT=8080

# Frontend & Proxy
# Compiled into the public bundle at image build time: never put a secret here.
VITE_API_BASE_URL=/api
VITE_GOOGLE_MAPS_API_KEY=
NGINX_PORT=80