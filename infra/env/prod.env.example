# Copy to prod.env and supply deployment credentials; blank secrets fail validation.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clims_db
DB_USER=clims_user
DB_PASSWORD=
DB_SSLMODE=disable
PORT=8080
JWT_SECRET=
NGINX_PORT=8088
BIND_ADDRESS=127.0.0.1
# Required only when building mobile release JavaScript artifacts.
EXPO_PUBLIC_API_URL=

# Web app (Vite). Compiled into the public bundle at image build time: never put a secret here.
VITE_API_BASE_URL=/api
VITE_GOOGLE_MAPS_API_KEY=
