FROM golang:1.26-alpine AS builder
WORKDIR /app
ARG VERSION
ARG COMMIT_HASH=unknown
ARG BUILD_TIME=unknown
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
COPY VERSION ./VERSION
RUN release_version="${VERSION:-$(cat VERSION)}" && test "$release_version" = "$(cat VERSION)" && \
  CGO_ENABLED=0 GOOS=linux go build \
  -ldflags="-s -w -X main.Version=${release_version} -X main.CommitHash=${COMMIT_HASH} -X main.BuildTime=${BUILD_TIME}" \
  -o /server ./cmd/server

FROM alpine:3.23
RUN apk add --no-cache curl ca-certificates && addgroup -S app && adduser -S -G app app
WORKDIR /app
ENV DOCS_DIR=/app/docs
COPY --from=builder --chown=app:app /server ./server
COPY docs/api ./docs/api
USER app
EXPOSE 8080
CMD ["./server"]
