# ==========================================
# MARIADB DATABASE CONFIGURATION
# ==========================================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=clims_db
MYSQL_USER=clims_user
MYSQL_PASSWORD=clims_password
DB_PORT=3307

# PostgreSQL Configuration
PG_HOST=postgres
PG_PORT=5432
PG_USER=clims_user
PG_PASSWORD=clims_password
PG_NAME=clims_db

# ==========================================
# GO BACKEND SERVICE CONFIGURATION
# ==========================================
DB_HOST=mariadb
DB_NAME=clims_db
DB_USER=clims_user
DB_PASSWORD=clims_password
PORT=8080

# ==========================================
# FRONTEND (VITE) BUILD CONFIGURATION
# Compiled into the public bundle at image build time: never put a secret here.
# ==========================================
# Same-origin path that the nginx proxy forwards to the backend.
VITE_API_BASE_URL=/api
# Browser key for the hotspot map; restrict it by HTTP referrer. Optional.
VITE_GOOGLE_MAPS_API_KEY=

# ==========================================
# NGINX PROXY CONFIGURATION
# ==========================================
NGINX_PORT=80