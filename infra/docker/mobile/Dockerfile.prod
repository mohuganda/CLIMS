FROM node:22-alpine AS builder
WORKDIR /app
ARG VERSION
ENV CI=1
ENV EXPO_NO_TELEMETRY=1
ARG EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN test -z "$VERSION" || test "$VERSION" = "$(node -p "require('./package.json').version")"
RUN test -n "$EXPO_PUBLIC_API_URL" && npm run export

# Production mobile is an artifact job, not a Metro server or native runtime.
FROM alpine:3.23
WORKDIR /bundle
COPY --from=builder /app/dist/ /bundle/
CMD ["sh", "-c", "tar -czf /artifacts/mobile-bundles.tar.gz.tmp -C /bundle . && mv /artifacts/mobile-bundles.tar.gz.tmp /artifacts/mobile-bundles.tar.gz && echo 'Mobile JavaScript artifacts exported to /artifacts/mobile-bundles.tar.gz'"]
