# Copy to `.env.local` for local development. Vite inlines every VITE_* value
# into the public bundle at build time, so nothing here may be a secret.

# Base URL the browser calls for the API. Leave as `/api` when the app is served
# behind the repo's Nginx proxy (or the dev proxy below); use an absolute URL
# only when the API lives on another origin and allows this one via CORS.
VITE_API_BASE_URL=/api

# Dev server only: where `npm run dev` forwards `/api/*`. Unset to disable.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Browser key for the hotspot map. Restrict it by HTTP referrer in Google Cloud;
# a browser key is visible to every visitor, the referrer restriction is the
# control. The map page shows a notice instead of a map when this is empty.
VITE_GOOGLE_MAPS_API_KEY=
