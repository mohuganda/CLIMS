FROM golang:1.26-alpine
WORKDIR /app/backend
RUN apk add --no-cache curl ca-certificates
RUN go install github.com/air-verse/air@v1.63.0
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
COPY docs/api /app/docs/api
ENV DOCS_DIR=/app/docs
EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
