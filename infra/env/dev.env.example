DB_HOST=localhost
DB_PORT=5432
DB_NAME=clims_db
DB_USER=clims_user
DB_PASSWORD=clims_password
DB_SSLMODE=disable
PORT=8080
JWT_SECRET=local-development-only-change-before-deployment

# Nginx gateway and Expo Metro development server
NGINX_PORT=8080
METRO_PORT=19000
BIND_ADDRESS=127.0.0.1
MOBILE_HOST=localhost
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Web app (Vite). Compiled into the public bundle: never put a secret here.
# Same-origin path that the Nginx gateway forwards to the backend.
VITE_API_BASE_URL=/api
# Browser key for the hotspot map; restrict it by HTTP referrer. Optional.
VITE_GOOGLE_MAPS_API_KEY=
